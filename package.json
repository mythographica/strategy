{
  "name": "@mnemonica/strategy",
  "version": "0.5.3",
  "description": "MCP server that lets AI agents inspect, define, and hot-swap Mnemonica types inside a running Node.js process — CDP bootstrap, then a WebSocket construction channel",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "mnemonica-strategy": "./lib/cli.js"
  },
  "scripts": {
    "build": "tsc && cp src/extract-types.js lib/extract-types.js",
    "watch": "tsc --watch",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "prepublishOnly": "npm run build && npm test",
    "live-craft:demo": "node bin/live-craft-demo.js"
  },
  "files": [
    "lib",
    "commands-mcp",
    "commands-rpc",
    "commands-run",
    "cdp-scripts",
    "docs",
    "README.md",
    "SKILL.md"
  ],
  "keywords": [
    "mnemonica",
    "mcp",
    "ai",
    "inheritance",
    "typescript",
    "debug-protocol",
    "chrome-devtools-protocol",
    "live-debugging",
    "hot-swap",
    "websocket"
  ],
  "author": "went.out@gmail.com",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mythographica/strategy.git"
  },
  "bugs": {
    "url": "https://github.com/mythographica/strategy/issues"
  },
  "homepage": "https://github.com/mythographica/strategy#readme",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "mnemonica": "^1.3.6"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "^0.34.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/ws": "^8.18.1",
    "jest": "^30.5.2",
    "mnemonica": "^1.3.6",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "chrome-remote-interface": "^0.34.0",
    "ws": "^8.22.0"
  }
}
